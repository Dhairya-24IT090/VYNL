{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VYNLServerSentEvents",
  "type": "object",
  "required": ["id", "type", "data"],
  "properties": {
    "id": { "type": "string" },
    "type": {
      "type": "string",
      "enum": [
        "job.completed", "job.failed",
        "draft.ready",
        "song.ready", "song.enriched",
        "suggestions.ready"
      ]
    },
    "data": { "type": "object" }
  }
}
