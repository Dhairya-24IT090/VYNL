{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VYNLJobCatalogPayloads",
  "definitions": {
    "collab_suggest": {
      "type": "object",
      "required": ["playlist_id", "version"],
      "properties": {
        "playlist_id": { "type": "string", "format": "uuid" },
        "version": { "type": "integer" }
      }
    },
    "monthly_wrap": {
      "type": "object",
      "required": ["user_id", "period"],
      "properties": {
        "user_id": { "type": "string", "format": "uuid" },
        "period": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" }
      }
    },
    "delete_account": {
      "type": "object",
      "required": ["user_id"],
      "properties": {
        "user_id": { "type": "string", "format": "uuid" }
      }
    }
  }
}
