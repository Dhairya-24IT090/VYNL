{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VYNLCollabWebSocketFrames",
  "definitions": {
    "ClientFrame": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": { "type": "string", "enum": ["add", "move", "remove", "resync", "suggestion.reject"] },
        "song_id": { "type": "string", "format": "uuid" },
        "item_id": { "type": "string", "format": "uuid" },
        "after_position": { "type": ["string", "null"] },
        "base_version": { "type": "integer", "minimum": 1 },
        "client_msg_id": { "type": "string" },
        "suggestion_id": { "type": "string", "format": "uuid" }
      }
    },
    "ServerFrame": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["snapshot", "op_applied", "ack", "presence", "suggestions", "role_changed", "error"]
        },
        "version": { "type": "integer" },
        "items": { "type": "array" },
        "role": { "type": "string", "enum": ["owner", "editor", "viewer"] },
        "collaborators": { "type": "array" },
        "presence": { "type": "array" },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "client_msg_id": { "type": "string" }
      }
    }
  }
}
