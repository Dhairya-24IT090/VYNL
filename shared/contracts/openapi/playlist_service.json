{
  "openapi": "3.0.3",
  "info": {
    "title": "VYNL Playlist Service API",
    "version": "1.0.0",
    "description": "API contract for personal playlists, collaborative editing, drafts, and item management"
  },
  "paths": {
    "/v1/playlists": {
      "post": {
        "summary": "Create playlist or save draft as playlist",
        "parameters": [
          { "name": "Idempotency-Key", "in": "header", "required": false, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "description": { "type": "string", "maxLength": 500 },
                  "is_collaborative": { "type": "boolean" },
                  "draft_id": { "type": "string", "format": "uuid" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Playlist created" },
          "400": { "description": "Validation error" },
          "401": { "description": "Unauthorized" }
        }
      },
      "get": {
        "summary": "List current user playlists (owned + shared)",
        "responses": {
          "200": { "description": "List of playlists" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/v1/playlists/{id}": {
      "get": {
        "summary": "Get playlist metadata and items",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "Playlist details" },
          "404": { "description": "Not found" }
        }
      },
      "patch": {
        "summary": "Update playlist details (owner only)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "If-Match", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Playlist updated" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "412": { "description": "Precondition failed (version conflict)" },
          "428": { "description": "Precondition required" }
        }
      },
      "delete": {
        "summary": "Delete playlist (owner only)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "If-Match", "in": "header", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Playlist deleted" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/v1/playlists/{id}/items": {
      "post": {
        "summary": "Add item to playlist",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "If-Match", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "201": { "description": "Item added" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "412": { "description": "Version conflict" }
        }
      },
      "put": {
        "summary": "Replace ordered items",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "If-Match", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Items replaced" },
          "403": { "description": "Forbidden" },
          "412": { "description": "Version conflict" }
        }
      }
    },
    "/v1/playlists/{id}/items/{itemId}": {
      "delete": {
        "summary": "Remove item from playlist",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "itemId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "If-Match", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Item removed" },
          "403": { "description": "Forbidden" },
          "412": { "description": "Version conflict" }
        }
      },
      "patch": {
        "summary": "Move item position",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "itemId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "If-Match", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Item moved" },
          "403": { "description": "Forbidden" },
          "412": { "description": "Version conflict" }
        }
      }
    },
    "/v1/playlists/{id}/playback": {
      "get": {
        "summary": "Get ordered playback items",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "from_item_id", "in": "query", "required": false, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Playback items" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/v1/playlists/{id}/items/{itemId}/playable": {
      "get": {
        "summary": "Check playable status or resolve",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "itemId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Song ready" },
          "202": { "description": "Song resolving (Location header)" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/v1/playlists/drafts/{draftId}": {
      "get": {
        "summary": "Get draft from Redis",
        "parameters": [{ "name": "draftId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "Draft items" },
          "404": { "description": "Draft expired or not found" }
        }
      },
      "patch": {
        "summary": "Adjust draft items",
        "parameters": [
          { "name": "draftId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "If-Match", "in": "header", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Draft adjusted" },
          "404": { "description": "Draft not found" }
        }
      },
      "delete": {
        "summary": "Discard draft",
        "parameters": [{ "name": "draftId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "Draft deleted" }
        }
      }
    },
    "/v1/playlists/{id}/invites": {
      "post": {
        "summary": "Create collaborative invite (owner only)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "201": { "description": "Invite created" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/v1/invites/redeem": {
      "post": {
        "summary": "Redeem invite token",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["token"], "properties": { "token": { "type": "string" } } } } }
        },
        "responses": {
          "200": { "description": "Invite redeemed" },
          "409": { "description": "Owner cannot redeem own invite" },
          "410": { "description": "Invite unavailable (expired, used, or revoked)" }
        }
      }
    }
  }
}
