{
  "openapi": "3.0.3",
  "info": {
    "title": "VYNL Wrap Service API",
    "version": "1.0.0",
    "description": "API contract for monthly wrap insights, caching, and refresh operations"
  },
  "paths": {
    "/v1/wrap/{period}": {
      "get": {
        "summary": "Get monthly wrap for specified UTC period YYYY-MM",
        "parameters": [
          { "name": "period", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" } }
        ],
        "responses": {
          "200": { "description": "Monthly wrap payload" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "No wrap data for period" },
          "422": { "description": "Malformed period format" }
        }
      }
    },
    "/v1/wrap/current/refresh": {
      "post": {
        "summary": "Request on-demand recalculation of current month wrap",
        "responses": {
          "202": { "description": "Recalculation enqueued" },
          "401": { "description": "Unauthorized" },
          "429": {
            "description": "Rate limited (1 request per 10 minutes)",
            "headers": {
              "Retry-After": { "schema": { "type": "integer" } }
            }
          }
        }
      }
    }
  }
}
